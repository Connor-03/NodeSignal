# NodeSignal systemd unit, installed by the nodesignal .deb.
# User=, Group= and the writable state directory (ReadWritePaths=) come from
# the drop-in that "nodesignal setup" writes at install time:
#   /etc/systemd/system/nodesignal.service.d/10-user.conf
# Settings live in /etc/nodesignal/config.json (keys are the daemon's flag
# names), so no secret ever appears on this command line.
[Unit]
Description=NodeSignal: encrypted chat between Bitcoin node operators
Documentation=https://github.com/Connor-03/NodeSignal
After=network-online.target bitcoind.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/nodesignal/node /opt/nodesignal/nodesignald.js --config /etc/nodesignal/config.json --web-root /opt/nodesignal
WorkingDirectory=/opt/nodesignal
Restart=on-failure
RestartSec=5
UMask=0077

# Hardening. The daemon only needs to read the node's cookie or bitcoin.conf,
# write its own state directory, and open TCP/UDP sockets.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
