# ============================================================================
#  NodeSignal — files that must never reach the repository
# ============================================================================

# --- SECRETS -----------------------------------------------------------
# Written by the installer. Contains your RPC username and password, and
# your web login token, in plain text.
nodesignal-config.json
*-config.json

# The daemon's private state: your X25519 identity PRIVATE KEY, every
# contact, and your full message history in the clear.
state.json
state.json.tmp
.nodesignal/

# Anything that looks like a credential or key
*.cookie
*.pem
*.key
.env
.env.*

# --- GENERATED BY THE INSTALLER ---------------------------------------
run-nodesignal.bat
run-nodesignal.sh

# --- DEPENDENCIES ------------------------------------------------------
# NodeSignal has none, but an older version installed these and they may
# linger in a working copy.
node_modules/
package-lock.json
npm-debug.log*
yarn.lock

# --- LOGS AND SCRATCH --------------------------------------------------
*.log
*.tmp
*.bak
*.orig
tmp/
test-output/

# --- EDITORS AND OS ----------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
